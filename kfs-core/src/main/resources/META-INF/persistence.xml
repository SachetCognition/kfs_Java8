        <class>org.kuali.kfs.coa.businessobject.BudgetRecordingLevel</class>
        <class>org.kuali.kfs.coa.businessobject.Chart</class>
        <class>org.kuali.kfs.coa.businessobject.FederalFunction</class>
        <class>org.kuali.kfs.coa.businessobject.FederalFundedCode</class>
        <class>org.kuali.kfs.coa.businessobject.FundGroup</class>
        <class>org.kuali.kfs.coa.businessobject.HigherEducationFunction</class>
