<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- GL module entities (S-2-GL migration) -->
        <class>org.kuali.kfs.gl.businessobject.AccountBalance</class>
        <class>org.kuali.kfs.gl.businessobject.AccountBalanceHistory</class>
        <class>org.kuali.kfs.gl.businessobject.Balance</class>
        <class>org.kuali.kfs.gl.businessobject.BalanceHistory</class>
        <class>org.kuali.kfs.gl.businessobject.CollectorDetail</class>
        <class>org.kuali.kfs.gl.businessobject.CollectorHeader</class>
        <class>org.kuali.kfs.gl.businessobject.CorrectionChange</class>
        <class>org.kuali.kfs.gl.businessobject.CorrectionChangeGroup</class>
        <class>org.kuali.kfs.gl.businessobject.CorrectionCriteria</class>
        <class>org.kuali.kfs.gl.businessobject.Encumbrance</class>
        <class>org.kuali.kfs.gl.businessobject.EncumbranceHistory</class>
        <class>org.kuali.kfs.gl.businessobject.Entry</class>
        <class>org.kuali.kfs.gl.businessobject.EntryHistory</class>
        <class>org.kuali.kfs.gl.businessobject.ExpenditureTransaction</class>
        <class>org.kuali.kfs.gl.businessobject.OrgReversionUnitOfWork</class>
        <class>org.kuali.kfs.gl.businessobject.OrgReversionUnitOfWorkCategoryAmount</class>
        <class>org.kuali.kfs.gl.businessobject.OriginEntryFull</class>
        <class>org.kuali.kfs.gl.businessobject.OriginEntryGroup</class>
        <class>org.kuali.kfs.gl.businessobject.OriginEntrySource</class>
        <class>org.kuali.kfs.gl.businessobject.PendingBalancesMove</class>
        <class>org.kuali.kfs.gl.businessobject.Reversal</class>
        <class>org.kuali.kfs.gl.businessobject.SufficientFundBalances</class>
        <class>org.kuali.kfs.gl.businessobject.SufficientFundRebuild</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="none"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
