<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- CAM module entities -->
        <class>org.kuali.kfs.module.cam.businessobject.Asset</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetAcquisitionType</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetComponent</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetCondition</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetDepreciationConvention</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetDepreciationMethod</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetForSearching</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetGlobal</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetGlobalDetail</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetGlpeSourceDetail</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetLocation</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetLocationGlobal</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetLocationGlobalDetail</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetLocationType</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetLock</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetObjectCode</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetOrganization</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetPayment</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetPaymentAllocationType</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetPaymentAssetDetail</class>
        <!-- AssetPaymentDetail deferred: extends SourceAccountingLine (not yet @MappedSuperclass) -->
        <class>org.kuali.kfs.module.cam.businessobject.AssetPaymentDocumentType</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetRepairHistory</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetRetirementGlobal</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetRetirementGlobalDetail</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetRetirementReason</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetStatus</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetType</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetWarranty</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetYearEndDepreciation</class>
        <class>org.kuali.kfs.module.cam.businessobject.AssetYearEndDepreciationDetail</class>
        <class>org.kuali.kfs.module.cam.businessobject.BarcodeInventoryErrorDetail</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="validate"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
