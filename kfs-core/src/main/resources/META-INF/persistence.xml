        <class>org.kuali.kfs.coa.businessobject.ObjectCode</class>
        <class>org.kuali.kfs.coa.businessobject.ObjectCodeCurrent</class>
        <class>org.kuali.kfs.coa.businessobject.ObjectCodeGlobal</class>
        <class>org.kuali.kfs.coa.businessobject.ObjectCodeGlobalDetail</class>
