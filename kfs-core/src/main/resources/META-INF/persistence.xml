<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- PDP module entities -->
        <class>org.kuali.kfs.pdp.businessobject.AccountingChangeCode</class>
        <class>org.kuali.kfs.pdp.businessobject.AchAccountNumber</class>
        <class>org.kuali.kfs.pdp.businessobject.ACHBank</class>
        <class>org.kuali.kfs.pdp.businessobject.ACHTransactionCode</class>
        <class>org.kuali.kfs.pdp.businessobject.ACHTransactionType</class>
        <class>org.kuali.kfs.pdp.businessobject.BankChangeHistory</class>
        <class>org.kuali.kfs.pdp.businessobject.Batch</class>
        <class>org.kuali.kfs.pdp.businessobject.CustomerBank</class>
        <class>org.kuali.kfs.pdp.businessobject.CustomerProfile</class>
        <class>org.kuali.kfs.pdp.businessobject.DisbursementNumberRange</class>
        <class>org.kuali.kfs.pdp.businessobject.DisbursementType</class>
        <class>org.kuali.kfs.pdp.businessobject.FormatProcess</class>
        <class>org.kuali.kfs.pdp.businessobject.GlPendingTransaction</class>
        <class>org.kuali.kfs.pdp.businessobject.PayeeACHAccount</class>
        <class>org.kuali.kfs.pdp.businessobject.PayeeType</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentAccountDetail</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentAccountHistory</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentChangeCode</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentDetail</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentGroup</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentGroupHistory</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentNoteText</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentProcess</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentStatus</class>
        <class>org.kuali.kfs.pdp.businessobject.PaymentType</class>
        <class>org.kuali.kfs.pdp.businessobject.ProcessSummary</class>
        <class>org.kuali.kfs.pdp.businessobject.PurchasingPaymentDetail</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="validate"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
