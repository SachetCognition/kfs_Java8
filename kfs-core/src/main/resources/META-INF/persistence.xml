<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- FP (Financial Processing) business objects -->
        <class>org.kuali.kfs.fp.businessobject.AdvanceDepositDetail</class>
        <class>org.kuali.kfs.fp.businessobject.BudgetAdjustmentSourceAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.BudgetAdjustmentTargetAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.CapitalAssetAccountsGroupDetails</class>
        <class>org.kuali.kfs.fp.businessobject.CapitalAssetInformation</class>
        <class>org.kuali.kfs.fp.businessobject.CapitalAssetInformationDetail</class>
        <class>org.kuali.kfs.fp.businessobject.CashDrawer</class>
        <class>org.kuali.kfs.fp.businessobject.CashieringDocument</class>
        <class>org.kuali.kfs.fp.businessobject.CashieringItemInProcess</class>
        <class>org.kuali.kfs.fp.businessobject.CheckBase</class>
        <class>org.kuali.kfs.fp.businessobject.CoinDetail</class>
        <class>org.kuali.kfs.fp.businessobject.CreditCardDetail</class>
        <class>org.kuali.kfs.fp.businessobject.CreditCardType</class>
        <class>org.kuali.kfs.fp.businessobject.CreditCardVendor</class>
        <class>org.kuali.kfs.fp.businessobject.CurrencyDetail</class>
        <class>org.kuali.kfs.fp.businessobject.CustomerCreditCardInformation</class>
        <class>org.kuali.kfs.fp.businessobject.Deposit</class>
        <class>org.kuali.kfs.fp.businessobject.DepositCashReceiptControl</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherAutomatedClearingHouse</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherNonEmployeeExpense</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherNonEmployeeTravel</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherNonResidentAlienTax</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherPayeeDetail</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherPreConferenceDetail</class>
        <class>org.kuali.kfs.fp.businessobject.DisbursementVoucherPreConferenceRegistrant</class>
        <class>org.kuali.kfs.fp.businessobject.FiscalYearFunctionControl</class>
        <class>org.kuali.kfs.fp.businessobject.FunctionControlCode</class>
        <class>org.kuali.kfs.fp.businessobject.GECSourceAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.GECTargetAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.InternalBillingItem</class>
        <class>org.kuali.kfs.fp.businessobject.IntraAccountAdjustmentSourceAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.IntraAccountAdjustmentTargetAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.MessageOfTheDay</class>
        <class>org.kuali.kfs.fp.businessobject.NonResidentAlienTaxPercent</class>
        <class>org.kuali.kfs.fp.businessobject.OffsetAccount</class>
        <class>org.kuali.kfs.fp.businessobject.PaymentReasonCode</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardDefault</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardHolder</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardSourceAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardTargetAccountingLine</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardTransaction</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardTransactionDetail</class>
        <class>org.kuali.kfs.fp.businessobject.ProcurementCardVendor</class>
        <class>org.kuali.kfs.fp.businessobject.SalesTax</class>
        <class>org.kuali.kfs.fp.businessobject.TaxIncomeClassCode</class>
        <class>org.kuali.kfs.fp.businessobject.TravelCompanyCode</class>
        <class>org.kuali.kfs.fp.businessobject.TravelExpenseTypeCode</class>
        <class>org.kuali.kfs.fp.businessobject.TravelMileageRate</class>
        <class>org.kuali.kfs.fp.businessobject.TravelPerDiem</class>
        <class>org.kuali.kfs.fp.businessobject.VoucherSourceAccountingLine</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="validate"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
