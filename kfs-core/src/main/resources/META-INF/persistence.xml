<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- sys module entities -->
        <class>org.kuali.kfs.sys.businessobject.FinancialSystemDocumentHeader</class>
        <class>org.kuali.kfs.sys.businessobject.Building</class>
        <class>org.kuali.kfs.sys.businessobject.HomeOrigination</class>
        <class>org.kuali.kfs.sys.businessobject.SystemOptions</class>
        <class>org.kuali.kfs.sys.businessobject.OriginationCode</class>
        <class>org.kuali.kfs.sys.businessobject.Room</class>
        <class>org.kuali.kfs.sys.businessobject.SourceAccountingLine</class>
        <class>org.kuali.kfs.sys.businessobject.TargetAccountingLine</class>
        <class>org.kuali.kfs.sys.businessobject.GeneralLedgerPendingEntry</class>
        <class>org.kuali.kfs.sys.businessobject.ElectronicPaymentClaim</class>
        <class>org.kuali.kfs.sys.businessobject.UnitOfMeasure</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegion</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegionRate</class>
        <class>org.kuali.kfs.sys.businessobject.FunctionalFieldDescription</class>
        <class>org.kuali.kfs.sys.businessobject.Bank</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegionType</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegionState</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegionCounty</class>
        <class>org.kuali.kfs.sys.businessobject.TaxRegionPostalCode</class>
        <class>org.kuali.kfs.sys.businessobject.PaymentSourceWireTransfer</class>
        <class>org.kuali.kfs.sys.businessobject.PaymentDocumentationLocation</class>
        <class>org.kuali.kfs.sys.businessobject.WireCharge</class>
        <class>org.kuali.kfs.sys.businessobject.UniversityDate</class>
        <class>org.kuali.kfs.sys.businessobject.FinancialSystemDocumentHeaderMissingFromWorkflow</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="validate"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
