<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA 3.1 persistence unit for the KFS OJB→JPA migration.

   This configuration coexists with the legacy OJB PersistenceBroker.
   Entity classes are registered here as individual modules are migrated.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="kfs" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Migrated entity classes (add here as OJB mappings are converted) -->
        <class>org.kuali.kfs.coa.businessobject.Chart</class>

        <!-- CG module entities (S-2-CG) -->
        <class>org.kuali.kfs.module.cg.businessobject.Agency</class>
        <class>org.kuali.kfs.module.cg.businessobject.AgencyAddress</class>
        <class>org.kuali.kfs.module.cg.businessobject.AgencyType</class>
        <class>org.kuali.kfs.module.cg.businessobject.Award</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardAccount</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardFundManager</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardOrganization</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardProjectDirector</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardStatus</class>
        <class>org.kuali.kfs.module.cg.businessobject.AwardSubcontractor</class>
        <class>org.kuali.kfs.module.cg.businessobject.BillingFrequency</class>
        <class>org.kuali.kfs.module.cg.businessobject.CFDA</class>
        <class>org.kuali.kfs.module.cg.businessobject.GrantDescription</class>
        <class>org.kuali.kfs.module.cg.businessobject.InstrumentType</class>
        <class>org.kuali.kfs.module.cg.businessobject.LetterOfCreditFund</class>
        <class>org.kuali.kfs.module.cg.businessobject.LetterOfCreditFundGroup</class>
        <class>org.kuali.kfs.module.cg.businessobject.Proposal</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalAwardType</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalOrganization</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalProjectDirector</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalPurpose</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalResearchRisk</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalStatus</class>
        <class>org.kuali.kfs.module.cg.businessobject.ProposalSubcontractor</class>
        <class>org.kuali.kfs.module.cg.businessobject.ResearchRiskType</class>
        <class>org.kuali.kfs.module.cg.businessobject.SubContractor</class>

        <properties>
            <!-- DataSource connection -->
            <property name="jakarta.persistence.jdbc.url"      value="${kfs.datasource.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${kfs.datasource.username}"/>
            <property name="jakarta.persistence.jdbc.password" value="${kfs.datasource.password}"/>
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>

            <!-- Hibernate settings (dialect auto-detected from JDBC URL) -->
            <property name="hibernate.hbm2ddl.auto"  value="validate"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
        </properties>
    </persistence-unit>

</persistence>
