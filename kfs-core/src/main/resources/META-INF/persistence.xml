<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA persistence unit for KFS.
   Coexists with Apache OJB during the Java 8 to Java 21 migration.
   Entity classes will be added here as modules are migrated from OJB to JPA.
-->
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
                                 http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

  <persistence-unit name="kfs-pu" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Entity classes will be registered here as they are migrated from OJB -->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <properties>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL5InnoDBDialect"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="false"/>
      <!-- do NOT auto-create/alter tables; KFS owns the schema via Liquibase -->
      <property name="hibernate.hbm2ddl.auto" value="none"/>
    </properties>
  </persistence-unit>

</persistence>
