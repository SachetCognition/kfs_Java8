<?xml version="1.0" encoding="UTF-8"?>
<!--
   JPA mappings for framework classes that live in external jars and cannot
   be annotated directly. KualiCodeBase (Kuali Rice) is the common base for
   all code/name/active reference entities; each entity overrides the column
   names via @AttributeOverrides.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                                     https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

    <mapped-superclass class="org.kuali.rice.krad.bo.KualiCodeBase" access="FIELD">
        <attributes>
            <id name="code">
                <column name="CODE"/>
            </id>
            <basic name="name">
                <column name="NM"/>
            </basic>
            <basic name="active">
                <column name="ACTV_IND"/>
                <convert converter="org.hibernate.type.YesNoConverter"/>
            </basic>
        </attributes>
    </mapped-superclass>

</entity-mappings>
