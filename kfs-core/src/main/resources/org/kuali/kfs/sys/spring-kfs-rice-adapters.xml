<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- 
        KFS Rice Adapter Beans
        
        These beans provide KFS-owned service interfaces that delegate to the
        underlying Rice service implementations. This allows KFS code to depend
        on KFS interfaces rather than directly on Rice, reducing coupling and
        enabling future Rice decoupling.
    -->

    <!-- DateTimeService adapter -->
    <bean id="kfsDateTimeService" class="org.kuali.kfs.sys.rice.impl.KfsDateTimeServiceImpl">
        <property name="dateTimeService" ref="dateTimeService"/>
    </bean>

    <!-- ConfigurationService adapter -->
    <bean id="kfsConfigurationService" class="org.kuali.kfs.sys.rice.impl.KfsConfigurationServiceImpl">
        <property name="configurationService" ref="configurationService"/>
    </bean>

    <!-- ParameterService adapter -->
    <bean id="kfsParameterService" class="org.kuali.kfs.sys.rice.impl.KfsParameterServiceImpl">
        <property name="parameterService" ref="parameterService"/>
    </bean>

    <!-- BusinessObjectService adapter -->
    <bean id="kfsBusinessObjectService" class="org.kuali.kfs.sys.rice.impl.KfsBusinessObjectServiceImpl">
        <property name="businessObjectService" ref="businessObjectService"/>
    </bean>

    <!-- DocumentService adapter -->
    <bean id="kfsDocumentService" class="org.kuali.kfs.sys.rice.impl.KfsDocumentServiceImpl">
        <property name="documentService" ref="documentService"/>
    </bean>

</beans>
